# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Ferramentas
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Dados locais do PyMail Client — NUNCA versionar.
# Contêm correio do usuário: banco, WAL, logs, rascunhos e anexos.
*.db
*.db-wal
*.db-shm
outbox-recuperado-*.json
config.toml
logs/
attachments/

# EXCEÇÃO deliberada: o banco de referência da versão 1 do schema PRECISA ser
# versionado (ver 06-estrategia-de-testes.md). Sem esta negação, a regra `*.db`
# acima o excluiria em silêncio, e os testes de migração passariam a rodar
# apenas contra bancos recém-criados — deixando de provar o que existem para
# provar: que uma migração preserva dados reais de um banco antigo.
!tests/fixtures/db/*.db

# Especificação de empacotamento
packaging/*.spec.bak
